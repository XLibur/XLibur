<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XLibur.Mcp</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xlibur-mcp</ToolCommandName>
    <PackageId>XLibur.Mcp</PackageId>
    <PackageType>McpServer</PackageType>
    <Description>An MCP server over XLibur: inspect, read, find, edit and recalculate Excel workbooks with a real formula engine, confined to the directories you name.</Description>
    <PackageTags>Excel OpenXml xlsx mcp model-context-protocol</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\resources\logo\nuget-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XLibur.Operations\XLibur.Operations.csproj" />
    <InternalsVisibleTo Include="XLibur.Operations.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

</Project>
