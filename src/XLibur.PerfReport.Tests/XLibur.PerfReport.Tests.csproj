<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must stay 'latest': TUnit's Assert.That overloads need C# 13+ overload resolution priority. -->
    <LangVersion>latest</LangVersion>
    <!-- Plural on purpose, as in the other test projects: build-and-test.yml restores, builds and tests with
         -p:TargetFrameworks=net10.0, which only lines up for a project that declares TargetFrameworks. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- An un-awaited TUnit assertion never runs, so CS4014 must fail the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="TUnit" Version="1.76.45" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XLibur.PerfReport\XLibur.PerfReport.csproj" />
  </ItemGroup>

</Project>
