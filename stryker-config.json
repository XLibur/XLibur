{
  "stryker-config": {
    "solution": "XLibur.Mutation.slnx",
    "project": "src/XLibur/XLibur.csproj",
    "test-projects": ["src/XLibur.Tests/XLibur.Tests.csproj"],
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "reporters": ["html", "markdown", "json", "progress"],
    "verbosity": "info",
    "coverage-analysis": "perTest",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutation-level": "Standard",
    "ignore-mutations": ["string", "linq"],
    "ignore-methods": ["Dispose", "ToString"]
  }
}
