<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must stay 'latest'. TUnit's Assert.That overloads are disambiguated with
         [OverloadResolutionPriority], which only C# 13+ honours; on net8.0 'default'
         means C# 12 and overload resolution silently breaks (CS0411/CS0121). -->
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- CS4014 (call not awaited) must fail the build. TUnit assertions are awaitable, so an
         un-awaited assertion never executes and the test passes no matter what it asserts.
         TreatWarningsAsErrors in Directory.Build.props already covers this; the rule is kept
         explicit so that it survives if that is ever relaxed again. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS4014</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1658;CS1584</NoWarn>
    <!-- TUnit runs on Microsoft.Testing.Platform rather than VSTest. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.xlsx" Exclude="**\~$*.xlsx;bin\**" />
    <EmbeddedResource Include="**\*.xlsm" Exclude="**\~$*.xlsm;bin\**" />
    <EmbeddedResource Include="Resource\Images\**\*.*" />
    <EmbeddedResource Include="Resource\Fonts\*.*" />
    <EmbeddedResource Include="Resource\Other\Unicode\let_it_go_in_emoji.txt" />
    <EmbeddedResource Include="Resource\Other\FormulaShifterCorpus.tsv" />
    <EmbeddedResource Include="Resource\Other\FormulaTextCorpus.tsv" />
    <!-- The chart golden corpus. Embedded rather than copied to the output directory: a release
         build normalises compile-time source paths, so nothing may resolve these from where their
         source files are. -->
    <EmbeddedResource Include="Excel\Charts\Golden\*.xml" />
    <!-- The DrawingML corpus (spec 16), embedded for the same reason. -->
    <EmbeddedResource Include="Excel\DrawingML\Golden\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="TUnit" Version="1.78.0" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 7.1.1 brings in System.Security.Cryptography.Pkcs 8.0.1 (net8.0)
       and 9.0.18 (net10.0), both flagged by CVE-2026-84008 and CVE-2026-70162. Pin the patched
       release of each line until a SqlClient release depends on it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XLibur\XLibur.csproj" />
    <ProjectReference Include="..\XLibur.Fonts.PinataLabs\XLibur.Fonts.PinataLabs.csproj" />
    <ProjectReference Include="..\XLibur.Examples\XLibur.Examples.csproj" />
  </ItemGroup>

</Project>
