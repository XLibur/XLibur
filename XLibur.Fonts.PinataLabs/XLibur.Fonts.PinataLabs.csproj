<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0;net9.0;net11.0</TargetFrameworks>
        <RootNamespace>XLibur.Fonts.PinataLabs</RootNamespace>
        <Description>PinataLabs.Typography implementation of IXLFontEngine for XLibur. PinataLabs.Typography is a maintained, Apache 2.0 fork of SixLabors.Fonts 1.x; this package supersedes XLibur.Fonts.SixLabors.V1.</Description>
        <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
        <PackageTags>Excel OpenXml xlsx Font PinataLabs Typography</PackageTags>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>Portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- The one copy of CarlitoBare lives in resources/fonts and is shared with the other engines.
             PinataLabsFontBootstrap and PinataLabsFontEngine look the fonts up by these logical names. -->
        <EmbeddedResource Include="..\resources\fonts\CarlitoBare-Bold.ttf" Link="Fonts\CarlitoBare-Bold.ttf" LogicalName="XLibur.Fonts.PinataLabs.Fonts.CarlitoBare-Bold.ttf" />
        <EmbeddedResource Include="..\resources\fonts\CarlitoBare-BoldItalic.ttf" Link="Fonts\CarlitoBare-BoldItalic.ttf" LogicalName="XLibur.Fonts.PinataLabs.Fonts.CarlitoBare-BoldItalic.ttf" />
        <EmbeddedResource Include="..\resources\fonts\CarlitoBare-Italic.ttf" Link="Fonts\CarlitoBare-Italic.ttf" LogicalName="XLibur.Fonts.PinataLabs.Fonts.CarlitoBare-Italic.ttf" />
        <EmbeddedResource Include="..\resources\fonts\CarlitoBare-Regular.ttf" Link="Fonts\CarlitoBare-Regular.ttf" LogicalName="XLibur.Fonts.PinataLabs.Fonts.CarlitoBare-Regular.ttf" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\resources\logo\nuget-logo.png" Pack="true" PackagePath="\" />
        <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\XLibur\XLibur.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The fonts that measure like a font the machine may not have, shared by every engine. -->
        <Compile Include="..\XLibur.Fonts.Shared\MetricCompatibleFonts.cs" Link="MetricCompatibleFonts.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
        <PackageReference Include="PinataLabs.Typography" Version="0.1.0" />
    </ItemGroup>

</Project>
